      "source": [
        "import hashlib\n",
        "import math\n",
        "from collections import Counter\n",
        "\n",
        "def sha256_hash(data: bytes) -> str:\n",
        "    return hashlib.sha256(data).hexdigest()\n",
        "\n",
        "\n",
        "def byte_entropy(data: bytes) -> float:\n",
        "    if not data:\n",
        "        return 0.0\n",
        "\n",
        "    counts = Counter(data)\n",
        "    length = len(data)\n",
        "\n",
        "    return -sum(\n",
        "        (count / length) * math.log2(count / length)\n",
        "        for count in counts.values()\n",
        "    )\n",
        "\n",
        "\n",
        "def static_analyze(data: bytes, entropy_threshold=7.5):\n",
        "    entropy = byte_entropy(data)\n",
        "\n",
        "    return {\n",
        "        \"sha256\": sha256_hash(data),\n",
        "        \"size_bytes\": len(data),\n",
        "        \"entropy\": round(entropy, 2),\n",
        "        \"likely_packed\": entropy >= entropy_threshold,\n",
        "    }\n",
        "\n",
        "\n",
        "normal_file = b\"This is a normal executable file.\"\n",
        "\n",
        "packed_file = bytes(range(256)) * 4\n",
        "\n",
        "normal_result = static_analyze(normal_file)\n",
        "packed_result = static_analyze(packed_file)\n",
        "\n",
        "print(\"Normal File Analysis\")\n",
        "print(normal_result)\n",
        "\n",
        "print(\"\\nPacked File Analysis\")\n",
        "print(packed_result)"
      ],
