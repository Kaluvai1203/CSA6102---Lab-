      "source": [
        "\n",
        "def recover_deleted_messages(sms_table):\n",
        "    \"\"\"\n",
        "    sms_table: list of dictionaries with\n",
        "    is_deleted (bool) and overwritten (bool)\n",
        "\n",
        "    Returns a list of deleted but recoverable messages.\n",
        "    \"\"\"\n",
        "\n",
        "    recoverable = [\n",
        "        row\n",
        "        for row in sms_table\n",
        "        if row[\"is_deleted\"] and not row[\"overwritten\"]\n",
        "    ]\n",
        "\n",
        "    return recoverable\n",
        "\n",
        "\n",
        "def summarize_table(sms_table):\n",
        "    active = [\n",
        "        row\n",
        "        for row in sms_table\n",
        "        if not row[\"is_deleted\"]\n",
        "    ]\n",
        "\n",
        "    recoverable = recover_deleted_messages(sms_table)\n",
        "\n",
        "    lost = [\n",
        "        row\n",
        "        for row in sms_table\n",
        "        if row[\"is_deleted\"] and row[\"overwritten\"]\n",
        "    ]\n",
        "\n",
        "    return {\n",
        "        \"active\": len(active),\n",
        "        \"recoverable\": len(recoverable),\n",
        "        \"permanently_lost\": len(lost)\n",
        "    }\n",
        "\n",
        "\n",
        "\n",
        "sms_table = [\n",
        "    {\n",
        "        \"id\": 1,\n",
        "        \"sender\": \"Alice\",\n",
        "        \"message\": \"Meeting at 10 AM\",\n",
        "        \"is_deleted\": False,\n",
        "        \"overwritten\": False\n",
        "    },\n",
        "    {\n",
        "        \"id\": 2,\n",
        "        \"sender\": \"Bob\",\n",
        "        \"message\": \"Secret Password\",\n",
        "        \"is_deleted\": True,\n",
        "        \"overwritten\": False\n",
        "    },\n",
        "    {\n",
        "        \"id\": 3,\n",
        "        \"sender\": \"Charlie\",\n",
        "        \"message\": \"OTP 456789\",\n",
        "        \"is_deleted\": True,\n",
        "        \"overwritten\": True\n",
        "    },\n",
        "    {\n",
        "        \"id\": 4,\n",
        "        \"sender\": \"David\",\n",
        "        \"message\": \"Call me\",\n",
        "        \"is_deleted\": False,\n",
        "        \"overwritten\": False\n",
        "    }\n",
        "]\n",
        "\n",
        "recoverable = recover_deleted_messages(sms_table)\n",
        "\n",
        "print(\"Recoverable Deleted Messages:\\n\")\n",
        "\n",
        "for msg in recoverable:\n",
        "    print(msg)\n",
        "\n",
        "summary = summarize_table(sms_table)\n",
        "\n",
        "print(\"\\nSummary:\")\n",
        "print(summary)"
