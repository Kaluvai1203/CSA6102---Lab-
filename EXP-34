        "import math\n",
        "from collections import Counter\n",
        "\n",
        "def shannon_entropy(s):\n",
        "    if not s:\n",
        "        return 0.0\n",
        "\n",
        "    counts = Counter(s)\n",
        "    length = len(s)\n",
        "\n",
        "    return -sum(\n",
        "        (count / length) * math.log2(count / length)\n",
        "        for count in counts.values()\n",
        "    )\n",
        "\n",
        "\n",
        "def detect_dns_tunneling(\n",
        "    queries,\n",
        "    length_threshold=20,\n",
        "    entropy_threshold=3.5\n",
        "):\n",
        "    \"\"\"\n",
        "    queries: list of domain names\n",
        "\n",
        "    Flags queries whose leftmost label is\n",
        "    both long and has high Shannon entropy.\n",
        "    \"\"\"\n",
        "\n",
        "    flagged = []\n",
        "\n",
        "    for query in queries:\n",
        "\n",
        "        label = query.split(\".\")[0]\n",
        "        entropy = shannon_entropy(label)\n",
        "\n",
        "        if (\n",
        "            len(label) >= length_threshold and\n",
        "            entropy >= entropy_threshold\n",
        "        ):\n",
        "            flagged.append({\n",
        "                \"query\": query,\n",
        "                \"label_length\": len(label),\n",
        "                \"entropy\": round(entropy, 2)\n",
        "            })\n",
        "\n",
        "    return flagged\n",
        "\n",
        "\n",
        "\n",
        "queries = [\n",
        "    \"www.google.com\",\n",
        "    \"mail.yahoo.com\",\n",
        "    \"abcdefghijklmnopqrstuvwxyz12345.example.com\",\n",
        "    \"a9f8d7c6b5e4f3g2h1j0k9l8m7n6.example.org\",\n",
        "    \"login.microsoft.com\",\n",
        "    \"x7h2k9m4q8r1t5v6y3z0p2n8a1b4.example.net\"\n",
        "]\n",
        "\n",
        "results = detect_dns_tunneling(queries)\n",
        "\n",
        "print(\"Potential DNS Tunneling Activity:\\n\")\n",
        "\n",
        "if results:\n",
        "    for item in results:\n",
        "        print(\"Query        :\", item[\"query\"])\n",
        "        print(\"Label Length :\", item[\"label_length\"])\n",
        "        print(\"Entropy      :\", item[\"entropy\"])\n",
        "        print(\"-\" * 45)\n",
        "else:\n",
        "    print(\"No suspicious DNS queries detected.\")"
